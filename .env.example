# Вход как в приложение EcoFlow. Кабинет разработчика не нужен.
# Пароль — от приложения EcoFlow, не от почты. В чат его не отправлять.
ECOFLOW_EMAIL=
ECOFLOW_PASSWORD=
ECOFLOW_HOST=https://api-e.ecoflow.com
ECOFLOW_SN=
PORT=4173
PUBLIC_PORT=4174
# Сильный пароль для доступа через домен; хранить только в .env.
PANEL_PASSWORD=

# Вход Mi Home. Пароль в чат не отправлять.
# de — Европа, ru — Россия, cn — Китай, us — США.
XIAOMI_USERNAME=
XIAOMI_PASSWORD=
XIAOMI_SERVER=de
